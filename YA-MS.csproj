<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YAMS</RootNamespace>
    <AssemblyName>YA-MS</AssemblyName>
    <Version>1.5.0</Version>
    <Product>YA-MS</Product>
    <Authors>Costantino Cerrotta IC8TEM</Authors>
    <Description>YA-MS - previsione e calcolo in diretta dell'efficienza degli sciami meteorici per il meteor scatter</Description>
    <ApplicationIcon>src/Assets/ya-ms.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);SYSLIB0014;CS0618;CS0168;CS0219;CS0414;CS0649;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="src/Assets/*.png" />
    <None Include="data/**" CopyToOutputDirectory="PreserveNewest" LinkBase="data" />
    <None Include="doc/**" CopyToOutputDirectory="PreserveNewest" LinkBase="doc" />
    <None Include="LEGGIMI.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
